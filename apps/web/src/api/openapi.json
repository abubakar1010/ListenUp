{
  "components": {
    "schemas": {
      "ChangeEntry": {
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/Entry"
          },
          "version": {
            "description": "The session `version` the client last saw",
            "minimum": 0.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": ["entry", "version"],
        "title": "ChangeEntry",
        "type": "object"
      },
      "ConfirmUpload": {
        "description": "Add an uploaded file to the library. YouTube links (#37) will be another shape.",
        "properties": {
          "keep_video": {
            "default": false,
            "description": "Keep the picture of a video (H.264 360p); otherwise only the sound is kept",
            "title": "Keep Video",
            "type": "boolean"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Defaults to the file name without its extension",
            "title": "Title"
          },
          "upload_id": {
            "format": "uuid",
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": ["upload_id"],
        "title": "ConfirmUpload",
        "type": "object"
      },
      "ContentDetail": {
        "description": "One item, with what its page needs to show and play it.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why processing failed; null unless failed",
            "title": "Error Code"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The reason, as the learner reads it",
            "title": "Error Detail"
          },
          "has_video": {
            "description": "The playback file has a picture (only with keep_video)",
            "title": "Has Video",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "keep_video": {
            "title": "Keep Video",
            "type": "boolean"
          },
          "media_object_id": {
            "format": "uuid",
            "title": "Media Object Id",
            "type": "string"
          },
          "media_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Play from here (redirects to a signed URL); null until playable",
            "title": "Media Url"
          },
          "peaks_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Waveform peaks JSON (redirects to a signed URL); null until playable",
            "title": "Peaks Url"
          },
          "source": {
            "enum": ["upload", "youtube"],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": ["pending", "downloading", "playable", "failed", "expired"],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "source",
          "status",
          "duration_ms",
          "created_at",
          "media_object_id",
          "has_video",
          "keep_video",
          "error_code",
          "error_detail",
          "media_url",
          "peaks_url"
        ],
        "title": "ContentDetail",
        "type": "object"
      },
      "ContentItem": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "source": {
            "enum": ["upload", "youtube"],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": ["pending", "downloading", "playable", "failed", "expired"],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["id", "title", "source", "status", "duration_ms", "created_at"],
        "title": "ContentItem",
        "type": "object"
      },
      "ContentList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `cursor` for the next page",
            "title": "Next Cursor"
          }
        },
        "required": ["items", "next_cursor"],
        "title": "ContentList",
        "type": "object"
      },
      "Credentials": {
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1000,
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "title": "Credentials",
        "type": "object"
      },
      "Entry": {
        "enum": ["blind", "dictation", "both"],
        "title": "Entry",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LibraryItem": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_session_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "Status of the newest practice session on this item; null when none"
          },
          "source": {
            "enum": ["upload", "youtube"],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "description": "Processing status of the clip's media",
            "enum": ["pending", "downloading", "playable", "failed", "expired"],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "source",
          "status",
          "duration_ms",
          "created_at",
          "last_session_status"
        ],
        "title": "LibraryItem",
        "type": "object"
      },
      "LibraryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LibraryItem"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `cursor` for the next page",
            "title": "Next Cursor"
          }
        },
        "required": ["items", "next_cursor"],
        "title": "LibraryPage",
        "type": "object"
      },
      "Me": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": ["id", "email", "display_name", "email_verified"],
        "title": "Me",
        "type": "object"
      },
      "PassageRange": {
        "description": "The practised part of the clip in milliseconds, half-open [start_ms, end_ms) (C2).",
        "properties": {
          "end_ms": {
            "description": "30 s to 15 min after start_ms, within the clip",
            "exclusiveMinimum": 0.0,
            "title": "End Ms",
            "type": "integer"
          },
          "start_ms": {
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "integer"
          }
        },
        "required": ["start_ms", "end_ms"],
        "title": "PassageRange",
        "type": "object"
      },
      "PasswordReset": {
        "properties": {
          "password": {
            "maxLength": 1000,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["token", "password"],
        "title": "PasswordReset",
        "type": "object"
      },
      "PasswordResetRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          }
        },
        "required": ["email"],
        "title": "PasswordResetRequest",
        "type": "object"
      },
      "PasswordResetRequested": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": ["detail"],
        "title": "PasswordResetRequested",
        "type": "object"
      },
      "Session": {
        "description": "A practice session with its plan, for \"Step N of M\" (UI-1).",
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "content_id": {
            "format": "uuid",
            "title": "Content Id",
            "type": "string"
          },
          "content_title": {
            "title": "Content Title",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "entry": {
            "$ref": "#/components/schemas/Entry"
          },
          "entry_locked": {
            "description": "True once Transcript has opened (FR-PL-5)",
            "title": "Entry Locked",
            "type": "boolean"
          },
          "entry_locked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry Locked At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "open_position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "N in 'Step N of M'; null when closed",
            "title": "Open Position"
          },
          "open_step": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Step"
              },
              {
                "type": "null"
              }
            ],
            "description": "The step the learner can work on; null if closed"
          },
          "passage": {
            "$ref": "#/components/schemas/PassageRange"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "step_count": {
            "description": "M in 'Step N of M': 4 or 5",
            "title": "Step Count",
            "type": "integer"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/SessionStep"
            },
            "title": "Steps",
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "description": "Send it back with every change; a stale one gets 409",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "content_id",
          "content_title",
          "passage",
          "entry",
          "status",
          "version",
          "steps",
          "step_count",
          "open_step",
          "open_position",
          "entry_locked",
          "entry_locked_at",
          "completed_at",
          "created_at",
          "updated_at"
        ],
        "title": "Session",
        "type": "object"
      },
      "SessionList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `cursor` for the next page",
            "title": "Next Cursor"
          }
        },
        "required": ["items", "next_cursor"],
        "title": "SessionList",
        "type": "object"
      },
      "SessionStatus": {
        "enum": ["active", "completed", "abandoned"],
        "title": "SessionStatus",
        "type": "string"
      },
      "SessionStep": {
        "properties": {
          "position": {
            "description": "1-based place in the plan",
            "title": "Position",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/StepStatus"
          },
          "step": {
            "$ref": "#/components/schemas/Step"
          }
        },
        "required": ["step", "position", "status"],
        "title": "SessionStep",
        "type": "object"
      },
      "SkipStep": {
        "properties": {
          "confirmed": {
            "default": false,
            "description": "The learner confirmed the skip; without it, 422",
            "title": "Confirmed",
            "type": "boolean"
          },
          "version": {
            "description": "The session `version` the client last saw",
            "minimum": 0.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": ["version"],
        "title": "SkipStep",
        "type": "object"
      },
      "StartSession": {
        "properties": {
          "content_id": {
            "format": "uuid",
            "title": "Content Id",
            "type": "string"
          },
          "entry": {
            "$ref": "#/components/schemas/Entry",
            "description": "Blind, Dictation or both (Blind first, OQ-1)"
          },
          "passage": {
            "$ref": "#/components/schemas/PassageRange"
          }
        },
        "required": ["content_id", "passage", "entry"],
        "title": "StartSession",
        "type": "object"
      },
      "Step": {
        "enum": ["blind", "dictation", "transcript", "card", "shadow"],
        "title": "Step",
        "type": "string"
      },
      "StepStatus": {
        "enum": ["locked", "open", "done", "skipped"],
        "title": "StepStatus",
        "type": "string"
      },
      "StorageUse": {
        "properties": {
          "max_file_bytes": {
            "title": "Max File Bytes",
            "type": "integer"
          },
          "quota_bytes": {
            "title": "Quota Bytes",
            "type": "integer"
          },
          "used_bytes": {
            "title": "Used Bytes",
            "type": "integer"
          }
        },
        "required": ["used_bytes", "quota_bytes", "max_file_bytes"],
        "title": "StorageUse",
        "type": "object"
      },
      "UploadRequest": {
        "properties": {
          "content_type": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Content Type",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "size_bytes": {
            "description": "The file's exact size; storage refuses any other",
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": ["filename", "content_type", "size_bytes"],
        "title": "UploadRequest",
        "type": "object"
      },
      "UploadTarget": {
        "description": "Where and how the browser sends the file: one PUT with exactly these headers.",
        "properties": {
          "expires_at": {
            "description": "The upload must start before this time",
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Headers",
            "type": "object"
          },
          "method": {
            "const": "PUT",
            "title": "Method",
            "type": "string"
          },
          "upload_id": {
            "format": "uuid",
            "title": "Upload Id",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["upload_id", "url", "method", "headers", "expires_at"],
        "title": "UploadTarget",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ListenUp API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": ["identity"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": ["identity"]
      }
    },
    "/api/v1/auth/password-reset": {
      "post": {
        "description": "Email a reset link. The answer is the same whether or not the email has an account.",
        "operationId": "request_password_reset_api_v1_auth_password_reset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetRequested"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Password Reset",
        "tags": ["identity"]
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "description": "Set a new password with the token from the email; signs the learner out everywhere.",
        "operationId": "reset_password_api_v1_auth_password_reset_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordReset"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reset Password",
        "tags": ["identity"]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": ["identity"]
      }
    },
    "/api/v1/contents": {
      "get": {
        "description": "The learner's content items, newest first, in keyset pages.",
        "operationId": "list_contents_api_v1_contents_get",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
