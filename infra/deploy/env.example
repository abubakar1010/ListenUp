# The production host's /opt/listenup/.env (mode 0600, owned by the deploy user).
# Every name compose.prod.yml reads. Values here are placeholders: real values live
# only on the host or in its secret store, never in the repository. Rotation steps per
# secret: docs/runbooks/deploy.md.

# --- Release and edge -----------------------------------------------------------
LISTENUP_REGISTRY=ghcr.io/abubakar1010
LISTENUP_ENVIRONMENT=production
LISTENUP_DOMAIN=listenup.example.org
LISTENUP_ACME_EMAIL=ops@example.org
LISTENUP_WEB_BASE_URL=https://listenup.example.org
# Origin of LISTENUP_S3_PUBLIC_ENDPOINT_URL, allowed in the CSP for media and uploads.
LISTENUP_MEDIA_ORIGIN=https://s3.provider.example

# --- Managed PostgreSQL 16: one login per role (Database Design 9.1) ---------------
# Use the provider's hostname, not an IP: the media worker reaches it by that name.
LISTENUP_MIGRATE_DATABASE_URL=postgresql://listenup_owner:CHANGE_ME@db.provider.example:5432/listenup?sslmode=require
LISTENUP_API_DATABASE_URL=postgresql://listenup_api:CHANGE_ME@db.provider.example:5432/listenup?sslmode=require
LISTENUP_WORKER_DATABASE_URL=postgresql://listenup_worker:CHANGE_ME@db.provider.example:5432/listenup?sslmode=require
LISTENUP_TRANSCRIPT_READ_DATABASE_URL=postgresql://listenup_worker:CHANGE_ME@db.provider.example:5432/listenup?sslmode=require
LISTENUP_ADMIN_REPORT_DATABASE_URL=postgresql://listenup_readonly:CHANGE_ME@db.provider.example:5432/listenup?sslmode=require

# --- Media bucket (private; the API's storage key) --------------------------------
LISTENUP_S3_ENDPOINT_URL=https://s3.provider.example
LISTENUP_S3_PUBLIC_ENDPOINT_URL=https://s3.provider.example
LISTENUP_S3_REGION=CHANGE_ME
LISTENUP_S3_ACCESS_KEY=CHANGE_ME
LISTENUP_S3_SECRET_KEY=CHANGE_ME
LISTENUP_S3_BUCKET=listenup-media

# --- Backup bucket (private, separate, its own key; ADR 0032) ---------------------
LISTENUP_BACKUP_BUCKET=listenup-backups
LISTENUP_BACKUP_S3_ENDPOINT_URL=https://s3.provider.example
LISTENUP_BACKUP_S3_REGION=CHANGE_ME
LISTENUP_BACKUP_S3_ACCESS_KEY=CHANGE_ME
LISTENUP_BACKUP_S3_SECRET_KEY=CHANGE_ME

# --- Media relay: the hostnames and ports in the database URL and S3 endpoint above --
LISTENUP_RELAY_DB_HOST=db.provider.example
LISTENUP_RELAY_DB_PORT=5432
LISTENUP_RELAY_S3_HOST=s3.provider.example
LISTENUP_RELAY_S3_PORT=443

# --- Email (SMTP provider) --------------------------------------------------------
LISTENUP_SMTP_HOST=smtp.provider.example
LISTENUP_SMTP_PORT=587
LISTENUP_SMTP_SECURITY=starttls
LISTENUP_SMTP_USERNAME=CHANGE_ME
LISTENUP_SMTP_PASSWORD=CHANGE_ME
LISTENUP_SMTP_SENDER=ListenUp <no-reply@listenup.example.org>

# --- Application ------------------------------------------------------------------
LISTENUP_ANALYTICS_HMAC_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
LISTENUP_TERMS_VERSION=terms-2026-1
LISTENUP_PRIVACY_VERSION=privacy-2026-1
LISTENUP_VOICE_CONSENT_VERSION=voice-2026-1
LISTENUP_ADMIN_EMAILS=
LISTENUP_GOOGLE_CLIENT_ID=
LISTENUP_GOOGLE_CLIENT_SECRET=
LISTENUP_GOOGLE_REDIRECT_URI=https://listenup.example.org/api/v1/auth/oidc/google/callback
LISTENUP_AI_CONFIG=
LISTENUP_AI_GROQ_API_KEY=

# --- Telemetry (optional, ADR 0031) -----------------------------------------------
LISTENUP_OTEL_ENABLED=false
LISTENUP_OTEL_TRACES_ENDPOINT=
LISTENUP_OTEL_METRICS_ENDPOINT=
LISTENUP_OTEL_HEADERS=
